          "type": "question",
          "settings": {
            "title": "2. What should I do if my item arrives damaged or defective?",
            "text": "<p><br/>Please contact us within 24 hours of receiving your order and include clear photos or a short video showing the issue. Once reviewed, our support team will help arrange an eligible replacement or refund.<br/><br/></p>"
          }
        },
        "question_hPz4h6": {
          "type": "question",
          "settings": {
            "title": "Can I cancel my order?",
            "text": "<p>You may request a cancellation before your order has been prepared or dispatched. Once the package has been handed to the delivery company, cancellation may no longer be possible. Contact us as soon as possible through WhatsApp for assistance.</p>"
