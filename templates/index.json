    "faq_A4adCG": {
      "type": "faq",
      "blocks": {
        "question_4ztBJn": {
          "type": "question",
          "settings": {
            "title": "Are the products safe to use?",
            "text": "<p>Yes, all our products are sourced from trusted suppliers and are safe for everyday use.<br/>You can find usage instructions and details on each product page.</p>"
          }
        },
        "question_9wPzUR": {
          "type": "question",
          "settings": {
            "title": "What if I receive a damaged or defective item?",
            "text": "<p>If an item arrives damaged or not working, we will replace it.<br/>Please contact us within 48 hours of delivery through email or WhatsApp.</p>"
          }
        },
        "question_hPz4h6": {
          "type": "question",
          "settings": {
            "title": "Can I cancel my order?",
            "text": "<p>Yes, we can cancel orders as long as they haven’t been shipped yet.<br/>Once the courier has picked up your order, we can no longer cancel it.</p>"
          }
        },
        "question_6mMfQ4": {
          "type": "question",
          "settings": {
            "title": "How can I contact customer support?",
            "text": "<p>You can always reach us at:<br/>📧 <a>hello@zeidbeauty.com</a><br/>📱 WhatsApp: +961 79 010 758</p>"
          }
        },
        "question_BgCjz4": {
          "type": "question",
          "settings": {
            "title": "How can I track my order?",
            "text": "<p>After your order is shipped, our local courier will message or call you with delivery updates.<br/>You can also reach out to us anytime if you need help.</p>"
          }
        },
        "question_WHh8pf": {
          "type": "question",
          "settings": {
            "title": "How does delivery work and how long does it take?",
            "text": "<p>We ship using trusted local couriers to ensure fast and reliable delivery. Once your order is processed, the courier will contact you by message or phone to confirm the delivery details. Most orders arrive within 2 to 5 business days anywhere in Lebanon. At the moment, we deliver within Lebanon only and do not offer international shipping.</p>"
          }
        },
        "question_4pwiTr": {
          "type": "question",
