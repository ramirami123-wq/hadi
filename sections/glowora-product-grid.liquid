{%- comment -%}
  GLOWORA TECH — Product Grid (collection / shop-all page)
  Install: save as sections/glowora-product-grid.liquid
  Use it as: (a) a homepage "Featured Collection" by picking a collection
  in the section settings, or (b) the main collection page — in Customize,
  go to a collection page and swap in "Glowora Product Grid" in place of
  the default product grid section.
{%- endcomment -%}

{%- assign glo_collection = collections[section.settings.collection] | default: collection -%}

<section class="glo-grid glo-container">
  {%- if section.settings.title != blank -%}
    <div class="glo-grid__head">
      <p class="glo-eyebrow">{{ section.settings.eyebrow | default: 'Shop The Collection' }}</p>
      <h2 class="glo-grid__title">{{ section.settings.title }}</h2>
    </div>
  {%- endif -%}

  <div class="glo-grid__cards" style="--glo-grid-cols: {{ section.settings.columns | default: 4 }};">
    {%- assign glo_limit = section.settings.limit | default: 8 -%}
    {%- for product in glo_collection.products limit: glo_limit -%}
      <a href="{{ product.url }}" class="glo-card">
        <div class="glo-card__media">
          {%- if product.compare_at_price > product.price -%}
            {%- assign glo_pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price -%}
            <span class="glo-card__badge">−{{ glo_pct | round }}%</span>
          {%- endif -%}
          {%- if product.featured_image -%}
            <img
              class="glo-card__img glo-card__img--main"
              src="{{ product.featured_image | image_url: width: 600 }}"
              alt="{{ product.featured_image.alt | default: product.title }}"
              loading="lazy" width="600" height="600">
            {%- if product.images[1] -%}
              <img
                class="glo-card__img glo-card__img--hover"
                src="{{ product.images[1] | image_url: width: 600 }}"
                alt="" loading="lazy" width="600" height="600">
            {%- endif -%}
          {%- else -%}
            <div class="glo-card__placeholder"></div>
          {%- endif -%}
        </div>
        <div class="glo-card__body">
          <h3 class="glo-card__title">{{ product.title }}</h3>
          <div class="glo-card__price">
            <span class="glo-card__price--now">{{ product.price | money }}</span>
            {%- if product.compare_at_price > product.price -%}
              <span class="glo-card__price--was">{{ product.compare_at_price | money }}</span>
            {%- endif -%}
          </div>
        </div>
        <span class="glo-card__cta">{{ section.settings.card_cta_text | default: 'View Product' }}</span>
      </a>
    {%- else -%}
      {%- for i in (1..4) -%}
        <div class="glo-card">
          <div class="glo-card__media"><div class="glo-card__placeholder"></div></div>
          <div class="glo-card__body"><h3 class="glo-card__title">Sample Product</h3><div class="glo-card__price"><span class="glo-card__price--now">$0.00</span></div></div>
        </div>
      {%- endfor -%}
    {%- endfor -%}
  </div>

  {%- if section.settings.show_view_all and glo_collection.url -%}
    <div class="glo-grid__footer">
      <a href="{{ glo_collection.url }}" class="glo-btn glo-btn--ghost">{{ section.settings.view_all_text | default: 'View All Products' }}</a>
    </div>
  {%- endif -%}
</section>

<style>
  .glo-grid{ padding: var(--glo-section-pad) 24px; }
  .glo-grid__head{ text-align: center; max-width: 560px; margin: 0 auto 44px; }
  .glo-grid__title{ font-family: var(--glo-font-display); font-weight: 500; font-size: clamp(28px, 3.4vw, 42px); color: var(--glo-ink); margin: 0; }

  .glo-grid__cards{
    display: grid; grid-template-columns: repeat(var(--glo-grid-cols, 4), 1fr); gap: 28px;
  }

  .glo-card{
    display: flex; flex-direction: column; text-decoration: none; color: inherit;
    background: var(--glo-white); border-radius: var(--glo-radius-card); overflow: hidden;
    box-shadow: var(--glo-shadow-card); transition: transform .3s ease, box-shadow .3s ease;
  }
  .glo-card:hover{ transform: translateY(-4px); box-shadow: var(--glo-shadow-soft); }

  .glo-card__media{ position: relative; aspect-ratio: 1; background: var(--glo-porcelain); overflow: hidden; }
  .glo-card__img{ position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: opacity .35s ease, transform .5s ease; }
  .glo-card__img--main{ opacity: 1; }
  .glo-card__img--hover{ opacity: 0; }
  .glo-card:hover .glo-card__img--main{ opacity: 0; }
  .glo-card:hover .glo-card__img--hover{ opacity: 1; }
  .glo-card:hover .glo-card__img{ transform: scale(1.04); }
  .glo-card__placeholder{ position: absolute; inset: 0; background: var(--glo-porcelain-dark); }

  .glo-card__badge{
    position: absolute; top: 14px; left: 14px; z-index: 2; background: var(--glo-ink); color: var(--glo-white);
    font-family: var(--glo-font-mono); font-size: 11px; letter-spacing: .04em; padding: 5px 10px; border-radius: var(--glo-radius-pill);
  }

  .glo-card__body{ padding: 18px 18px 8px; flex: 1; }
  .glo-card__title{
    font-family: var(--glo-font-body); font-weight: 600; font-size: 14.5px; line-height: 1.4;
    color: var(--glo-ink); margin: 0 0 8px;
  }
  .glo-card__price{ display: flex; align-items: baseline; gap: 8px; }
  .glo-card__price--now{ font-family: var(--glo-font-mono); font-size: 14px; color: var(--glo-bronze-dark); font-weight: 500; }
  .glo-card__price--was{ font-family: var(--glo-font-mono); font-size: 12px; color: var(--glo-ink-soft); text-decoration: line-through; }

  .glo-card__cta{
    font-family: var(--glo-font-body); font-weight: 600; font-size: 12px; letter-spacing: .04em; text-transform: uppercase;
    color: var(--glo-ink-soft); padding: 12px 18px 18px; display: block; opacity: 0; transform: translateY(4px);
    transition: opacity .25s ease, transform .25s ease;
  }
  .glo-card:hover .glo-card__cta{ opacity: 1; transform: translateY(0); color: var(--glo-bronze-dark); }

  .glo-grid__footer{ text-align: center; margin-top: 48px; }

  @media (max-width: 980px){ .glo-grid__cards{ grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px){ .glo-grid__cards{ grid-template-columns: 1fr 1fr; gap: 16px; } .glo-card__body{ padding: 12px 12px 4px; } .glo-card__title{ font-size: 13px; } }
</style>

{% schema %}
{
  "name": "Glowora Product Grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "title", "label": "Title (leave blank to hide heading)" },
    { "type": "collection", "id": "collection", "label": "Collection (leave blank to use current collection page)" },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Columns (desktop)", "default": 4 },
    { "type": "range", "id": "limit", "min": 4, "max": 24, "step": 4, "label": "Max products shown", "default": 8 },
    { "type": "text", "id": "card_cta_text", "label": "Card hover CTA text" },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'View All' button", "default": true },
    { "type": "text", "id": "view_all_text", "label": "'View All' button text" }
  ],
  "presets": [{ "name": "Glowora Product Grid" }]
}
{% endschema %}
