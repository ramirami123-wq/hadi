<section class="glowora-grid-section">

  <div class="glowora-wrapper">

    <div class="glowora-title">
      <h2>{{ section.settings.title }}</h2>
      <p>{{ section.settings.subtitle }}</p>
    </div>


    <div class="glowora-products">

      {% assign collection = collections[section.settings.collection] %}


      {% for product in collection.products limit: section.settings.products_to_show %}

        <div class="glowora-product-card">


          {% if product.compare_at_price > product.price %}
            <span class="glowora-sale">
              SALE
            </span>
          {% endif %}


          <a href="{{ product.url }}" class="glowora-product-image">

            <img
            src="{{ product.featured_image | image_url: width:700 }}"
            alt="{{ product.title }}"
            loading="lazy">

          </a>



          <div class="glowora-product-info">


            <div class="glowora-rating">
              ★★★★★
            </div>


            <h3>
              <a href="{{ product.url }}">
                {{ product.title }}
              </a>
            </h3>



            <div class="glowora-price">

              {% if product.compare_at_price > product.price %}

                <span class="old">
                  {{ product.compare_at_price | money }}
                </span>

              {% endif %}


              <span>
                {{ product.price | money }}
              </span>

            </div>



            <form method="post" action="/cart/add">

              <input 
              type="hidden"
              name="id"
              value="{{ product.selected_or_first_available_variant.id }}">


              <button type="submit">
                ADD TO CART
              </button>

            </form>


          </div>


        </div>

      {% endfor %}


    </div>

  </div>

</section>




<style>

.glowora-grid-section{
padding:70px 20px;
background:#fbf8f3;
}


.glowora-wrapper{
max-width:1400px;
margin:auto;
}



.glowora-title{
text-align:center;
margin-bottom:45px;
}


.glowora-title h2{
font-size:38px;
font-weight:600;
color:#222;
}


.glowora-title p{
color:#777;
font-size:16px;
}



.glowora-products{

display:grid;
grid-template-columns:repeat(4,1fr);
gap:25px;

}



.glowora-product-card{

background:white;
border-radius:25px;
overflow:hidden;
padding:15px;
position:relative;
transition:.3s;

}



.glowora-product-card:hover{

transform:translateY(-7px);
box-shadow:0 20px 40px rgba(0,0,0,.08);

}



.glowora-sale{

position:absolute;
top:25px;
left:25px;
background:#b99a67;
color:white;
padding:7px 15px;
border-radius:30px;
font-size:12px;
z-index:2;

}



.glowora-product-image{

display:block;
overflow:hidden;
border-radius:20px;

}


.glowora-product-image img{

width:100%;
transition:.4s;

}



.glowora-product-card:hover img{

transform:scale(1.05);

}



.glowora-product-info{

padding:15px 5px;

}



.glowora-rating{

color:#c7a15b;
font-size:14px;

}



.glowora-product-info h3{

font-size:17px;
font-weight:500;
margin:10px 0;
}


.glowora-product-info h3 a{

text-decoration:none;
color:#222;

}



.glowora-price{

font-size:18px;
font-weight:600;

}



.old{

color:#999;
text-decoration:line-through;
margin-right:8px;
font-size:15px;

}



.glowora-product-info button{

width:100%;
margin-top:18px;
padding:14px;
border-radius:50px;
border:none;
background:#222;
color:white;
cursor:pointer;
font-size:14px;
letter-spacing:.5px;

}


.glowora-product-info button:hover{

background:#b99a67;

}



@media(max-width:900px){

.glowora-products{
grid-template-columns:repeat(2,1fr);
}

}



@media(max-width:550px){

.glowora-products{
grid-template-columns:1fr;
}

}

</style>




{% schema %}
{
"name":"Glowora Grid",
"settings":[

{
"type":"text",
"id":"title",
"label":"Title",
"default":"Shop Our Best Sellers"
},

{
"type":"text",
"id":"subtitle",
"label":"Subtitle",
"default":"Advanced beauty technology for your daily routine"
},

{
"type":"collection",
"id":"collection",
"label":"Choose Collection"
},

{
"type":"range",
"id":"products_to_show",
"label":"Products to display",
"min":4,
"max":16,
"step":4,
"default":8
}

],

"presets":[
{
"name":"Glowora Grid"
}
]

}
{% endschema %}