<section class="glowora-products">
  <div class="glowora-container">

    <div class="glowora-header">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>

    <div class="glowora-grid">

      {% for product in collections[section.settings.collection].products limit: section.settings.products_limit %}

        <div class="glowora-card">

          {% if product.compare_at_price > product.price %}
            <div class="glowora-badge">
              SALE
            </div>
          {% endif %}

          <a href="{{ product.url }}" class="glowora-image">
            <img 
              src="{{ product.featured_image | image_url: width:600 }}"
              loading="lazy"
              alt="{{ product.title }}">
          </a>


          <div class="glowora-info">

            <div class="glowora-stars">
              ★★★★★
            </div>


            <h3>
              {{ product.title }}
            </h3>


            <div class="glowora-price">

              {% if product.compare_at_price > product.price %}
                <span class="glowora-old-price">
                  {{ product.compare_at_price | money }}
                </span>
              {% endif %}

              <span>
                {{ product.price | money }}
              </span>

            </div>


            <form method="post" action="/cart/add">

              <input 
                type="hidden"
                name="id"
                value="{{ product.selected_or_first_available_variant.id }}">

              <button class="glowora-button">
                Add To Cart
              </button>

            </form>


          </div>

        </div>

      {% endfor %}

    </div>

  </div>
</section>



<style>

.glowora-products {
  padding: 80px 20px;
  background: #faf8f5;
}


.glowora-container {
  max-width: 1300px;
  margin: auto;
}


.glowora-header {
  text-align: center;
  margin-bottom: 45px;
}


.glowora-header h2 {
  font-size: 38px;
  font-weight: 600;
  letter-spacing: -1px;
  color: #1d1d1d;
  margin-bottom: 12px;
}


.glowora-header p {
  color: #777;
  font-size: 16px;
}



.glowora-grid {
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 25px;
}



.glowora-card {

  background: white;
  border-radius: 24px;
  padding: 18px;
  position: relative;
  transition: all .35s ease;
  border: 1px solid #eee;

}



.glowora-card:hover {

  transform: translateY(-8px);
  box-shadow: 0 20px 45px rgba(0,0,0,.08);

}



.glowora-badge {

  position:absolute;
  top:28px;
  left:28px;
  background:#b89b6a;
  color:white;
  padding:7px 15px;
  border-radius:30px;
  font-size:12px;
  letter-spacing:1px;
  z-index:2;

}



.glowora-image {

  display:block;
  overflow:hidden;
  border-radius:20px;

}



.glowora-image img {

  width:100%;
  display:block;
  transition:.4s ease;

}



.glowora-card:hover img {

  transform:scale(1.06);

}



.glowora-info {

  padding:18px 5px 5px;

}



.glowora-stars {

  color:#c9a96e;
  font-size:14px;
  margin-bottom:8px;

}



.glowora-info h3 {

  font-size:17px;
  font-weight:500;
  line-height:1.4;
  color:#222;
  margin:8px 0 12px;

}



.glowora-price {

  font-size:18px;
  font-weight:600;
  color:#111;

}



.glowora-old-price {

  color:#999;
  text-decoration:line-through;
  margin-right:8px;
  font-size:15px;

}



.glowora-button {

  width:100%;
  margin-top:18px;
  padding:14px;
  border:none;
  border-radius:50px;
  background:#1d1d1d;
  color:white;
  font-size:15px;
  cursor:pointer;
  transition:.3s ease;

}



.glowora-button:hover {

  background:#b89b6a;

}




@media(max-width:1000px){

  .glowora-grid{
    grid-template-columns:repeat(2,1fr);
  }

}



@media(max-width:600px){

  .glowora-products{
    padding:50px 15px;
  }


  .glowora-grid{
    grid-template-columns:1fr;
  }


  .glowora-header h2{
    font-size:30px;
  }

}

</style>



{% schema %}
{
  "name": "Glowora Products",
  "settings": [

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover Our Best Sellers"
    },

    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Advanced beauty technology designed for your everyday glow"
    },

    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },

    {
      "type": "range",
      "id": "products_limit",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 2,
      "default": 8
    }

  ],

  "presets": [
    {
      "name": "Glowora Products"
    }
  ]
}
{% endschema %}